generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id            String       @id @default(uuid())
  nome          String
  descricao     String?

  preco         Decimal      @db.Decimal(10, 2)
  ativo         Boolean      @default(true)

  destaque      Boolean      @default(false)

  disponivelSeg Boolean      @default(true)
  disponivelTer Boolean      @default(true)
  disponivelQua Boolean      @default(true)
  disponivelQui Boolean      @default(true)
  disponivelSex Boolean      @default(true)
  disponivelSab Boolean      @default(true)
  disponivelDom Boolean      @default(true)

  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  itensPedido   ItemPedido[]
  adicionais    Adicional[]  // 🔥 RELAÇÃO OK
}

model Pedido {
  id                String           @id @default(uuid())

  codigo            Int?             @unique

  status            StatusPedido     @default(AGUARDANDO_PAGAMENTO)
  total             Decimal          @db.Decimal(10, 2)

  telefone          String?
  endereco          String?
  tipo              TipoPedido       @default(ONLINE)

  pagamentoId       String?          @unique
  externalReference String?          @unique
  statusPagamento   StatusPagamento?

  origem            OrigemPedido?

  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  itens             ItemPedido[]

  auditoriaId       String?
  auditoria         AuditoriaMensal? @relation(fields: [auditoriaId], references: [id])

  @@index([status])
  @@index([criadoEm])
}

model ItemPedido {
  id         String  @id @default(uuid())
  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)

  pedidoId   String
  produtoId  String

  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id])

  // 🔥 ESSENCIAL (faltava isso)
  adicionais ItemPedidoAdicional[]
}

model Adicional {
  id        String  @id @default(uuid())
  nome      String
  preco     Decimal @db.Decimal(10, 2)
  ativo     Boolean @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  criadoEm  DateTime @default(now())
}

model ItemPedidoAdicional {
  id            String  @id @default(uuid())
  nome          String
  preco         Decimal @db.Decimal(10, 2)

  itemPedidoId  String
  itemPedido    ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
}

model Usuario {
  id       String   @id @default(uuid())
  nome     String
  email    String   @unique
  senha    String
  role     Role     @default(ADMIN)
  criadoEm DateTime @default(now())
}

model AuditoriaMensal {
  id          String   @id @default(uuid())
  mes         Int
  ano         Int
  totalVendas Decimal  @db.Decimal(10, 2)
  produtos    Json
  criadoEm    DateTime @default(now())

  pedidos     Pedido[]

  @@unique([mes, ano])
}

enum StatusPedido {
  RECEBIDO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
  AGUARDANDO_PAGAMENTO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum Role {
  ADMIN
}

enum TipoPedido {
  MESA
  RETIRADA
  ENTREGA
  ONLINE
}

enum OrigemPedido {
  QR_CODE
  APP
  ADMIN
  BALCAO
}
