generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  preco     Decimal @db.Decimal(10, 2)
  ativo     Boolean @default(true)

  destaque Boolean @default(false)

  disponivelSeg Boolean @default(true)
  disponivelTer Boolean @default(true)
  disponivelQua Boolean @default(true)
  disponivelQui Boolean @default(true)
  disponivelSex Boolean @default(true)
  disponivelSab Boolean @default(true)
  disponivelDom Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itensPedido ItemPedido[]
}

model Pedido {
  id       String       @id @default(uuid())
  status   StatusPedido @default(RECEBIDO)
  tipo     TipoPedido   @default(ONLINE)
  total    Decimal      @db.Decimal(10, 2)
  telefone String?
  origem   String?
  endereco String?

  // 🔥 NOVO (IMPORTANTE PARA PAGAMENTO)
  pagamentoId     String? // id do Mercado Pago
  statusPagamento String? // aprovado, pendente, recusado

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itens ItemPedido[]

  auditoriaId String?
  auditoria   AuditoriaMensal? @relation(fields: [auditoriaId], references: [id])
}

model ItemPedido {
  id         String  @id @default(uuid())
  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)

  pedido   Pedido @relation(fields: [pedidoId], references: [id])
  pedidoId String

  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String
}

model Usuario {
  id       String   @id @default(uuid())
  nome     String
  email    String   @unique
  senha    String
  role     Role     @default(ADMIN)
  criadoEm DateTime @default(now())
}

model AuditoriaMensal {
  id          String   @id @default(uuid())
  mes         Int
  ano         Int
  totalVendas Decimal  @db.Decimal(10, 2)
  produtos    Json
  criadoEm    DateTime @default(now())

  pedidos Pedido[]
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  RECEBIDO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum Role {
  ADMIN
}

enum TipoPedido {
  MESA
  RETIRADA
  ENTREGA
  ONLINE
}
