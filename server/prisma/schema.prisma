generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Produto {
  id            String       @id @default(uuid())
  nome          String
  descricao     String?

  preco         Decimal      @db.Decimal(10, 2)
  ativo         Boolean      @default(true)

  destaque      Boolean      @default(false)

  disponivelSeg Boolean      @default(true)
  disponivelTer Boolean      @default(true)
  disponivelQua Boolean      @default(true)
  disponivelQui Boolean      @default(true)
  disponivelSex Boolean      @default(true)
  disponivelSab Boolean      @default(true)
  disponivelDom Boolean      @default(true)

  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  itensPedido   ItemPedido[]
  adicionais    Adicional[]
  variacoes     VariacaoProduto[]
}


model Pedido {
  id                String           @id @default(uuid())

  codigo            Int?             @unique

  status            StatusPedido     @default(AGUARDANDO_PAGAMENTO)
  total             Decimal          @db.Decimal(10, 2)

  telefone          String?
  endereco          String?
  tipo              TipoPedido       @default(ONLINE)

  pagamentoId       String?          @unique
  externalReference String?          @unique
  statusPagamento   StatusPagamento?

  origem            OrigemPedido?

  //  FIADO / CRÉDITO
  clienteNome       String?
  formaPagamentoBalcao FormaPagamentoBalcao?
  pago              Boolean          @default(true)

  //  RELAÇÃO COM CLIENTE (CORRETO)
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  entregueEm DateTime?

  itens             ItemPedido[]

  auditoriaId       String?
  auditoria         AuditoriaMensal? @relation(fields: [auditoriaId], references: [id])

  @@index([status])
  @@index([criadoEm])
}

model ItemPedido {
  id         String  @id @default(uuid())
  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)
  nomeProduto String?
  descricaoProduto String?

  pedidoId   String
  produtoId  String

  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id])

  adicionais ItemPedidoAdicional[]
}



model Adicional {
  id        String  @id @default(uuid())
  nome      String
  preco     Decimal @db.Decimal(10, 2)
  ativo     Boolean @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  criadoEm  DateTime @default(now())
}

model VariacaoProduto {
  id        String   @id @default(uuid())

  nome      String
  preco     Decimal  @db.Decimal(10, 2)

  ativo     Boolean  @default(true)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  criadoEm  DateTime @default(now())

  @@index([produtoId])
}



model ItemPedidoAdicional {
  id            String  @id @default(uuid())
  nome          String
  preco         Decimal @db.Decimal(10, 2)

  quantidade    Int      @default(1) //  NOVO

  itemPedidoId  String
  itemPedido    ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
}



model Usuario {
  id       String   @id @default(uuid())
  nome     String
  email    String   @unique
  senha    String
  role     Role     @default(ADMIN)
  criadoEm DateTime @default(now())
}



model AuditoriaMensal {
  id          String   @id @default(uuid())
  mes         Int
  ano         Int
  totalVendas Decimal  @db.Decimal(10, 2)
  produtos    Json
  criadoEm    DateTime @default(now())

  pedidos     Pedido[]

  @@unique([mes, ano])
}



enum StatusPedido {
  RECEBIDO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
  AGUARDANDO_PAGAMENTO
}



enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}



enum Role {
  ADMIN
}



enum TipoPedido {
  MESA
  RETIRADA
  ENTREGA
  ONLINE
}



enum OrigemPedido {
  QR_CODE
  APP
  ADMIN
  BALCAO
}



enum FormaPagamentoBalcao {
  PAGO
  FIADO
  CREDITO
}
enum TipoRelatorio {
  DIARIO
  SEMANAL
  MENSAL
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String   @unique
  credito   Decimal  @db.Decimal(10, 2) @default(0)

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pedidos   Pedido[]
}

model SecurityLog {
  id          String   @id @default(uuid())

  tipo        String
  acao        String

  usuario     String?

  entidade    String?
  entidadeId  String?

  detalhes    Json?

  criadoEm    DateTime @default(now())

  @@index([tipo])
  @@index([acao])
  @@index([criadoEm])
}
model Configuracao {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("configuracoes")
}

model Relatorio {
  id             String @id @default(uuid())

  tipo           TipoRelatorio

  referencia     String

  periodoInicio  DateTime
  periodoFim     DateTime

  dados          Json

  arquivoPdf     String?

  enviadoEmail   Boolean @default(false)

  enviadoWhatsapp Boolean @default(false)

  ultimoWhatsappEnviadoEm DateTime?

  criadoEm       DateTime @default(now())

  @@unique([tipo, referencia])

  @@index([tipo])
  @@index([referencia])
}
model ExecucaoRelatorio {
  id            String @id @default(uuid())

  tipo          TipoRelatorio

  referencia    String

  executadoEm   DateTime @default(now())

  status        String

  observacao    String?

  @@unique([tipo, referencia])
}

model Propaganda {
  id        String   @id @default(uuid())

  nome      String

  tipo      String

  arquivo   String

  duracao   Int?

  ativo     Boolean  @default(true)

  criadoEm  DateTime @default(now())

  playlists PlaylistItem[]
}

model Playlist {
  id        String   @id @default(uuid())

  nome      String

  ativa     Boolean  @default(false)

  criadoEm  DateTime @default(now())

  itens     PlaylistItem[]

  tvs       TV[]
}
model PlaylistItem {
  id String @id @default(uuid())

  ordem Int

  playlistId String
  propagandaId String

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  propaganda Propaganda @relation(fields: [propagandaId], references: [id])

  @@index([playlistId])

  @@unique([playlistId, propagandaId])
}
model TV {
  id         String   @id @default(uuid())

  nome       String

  codigo     String   @unique

  ativa      Boolean  @default(true)

  playlistId String?

  playlist   Playlist? @relation(fields: [playlistId], references: [id])

  ultimaSync DateTime?

  criadoEm   DateTime @default(now())

  @@index([playlistId])
}