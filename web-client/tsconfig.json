{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"]
    },

    "types": ["vite-plugin-pwa"]
  },
  "include": ["src", "types"]
}